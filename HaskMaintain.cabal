cabal-version:       >=1.10
name:                HaskMaintain
version:             0.2.0.0
synopsis:            A Haskell codebase analyzer for maintainability.
description:         HaskMaintain analyzes a Haskell codebase and provides metrics like lines of code, function count, and cyclomatic complexity.
license:             MIT
license-file:        LICENSE
author:              Raj Kashikar
maintainer:          rajskashikar@gmail.com
category:            Development
build-type:          Simple
extra-source-files:  README.md

executable HaskMaintain
  main-is:             Main.hs
  hs-source-dirs:      app, src
  build-depends:       base >=4.7 && <5,
                       aeson,
                       directory,
                       filepath,
                       haskell-src-exts,
                       text,
                       time
  default-language:    Haskell2010

library
  exposed-modules:     Analyzer
                       CLI
                       Complexity
                       Config
                       Metrics
                       Parser
                       Report
                       Scanner
                       Types
  hs-source-dirs:      src
  build-depends:       base >=4.7 && <5,
                       aeson,
                       directory,
                       filepath,
                       haskell-src-exts,
                       text,
                       time
  default-language:    Haskell2010


test-suite haskmaintain-test
  type:                exitcode-stdio-1.0
  main-is:             Spec.hs
  hs-source-dirs:      test, src
  build-depends:       base >=4.7 && <5,
                       aeson,
                       directory,
                       filepath,
                       haskell-src-exts,
                       hspec,
                       text,
                       time
  default-language:    Haskell2010
